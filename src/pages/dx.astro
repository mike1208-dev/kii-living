---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { company, dx, partnership } from '../data/site';

---

<Base title={`不動産DX | ${company.name}`} description="オンライン相談・オンライン内見・電子契約など、テクノロジーで不動産取引をなめらかに。来店不要でスピーディーなお取引を実現します。">
  <PageHero eyebrow={dx.eyebrow} title={dx.title} lead={dx.lead} image="/images/photos/service-03.jpg" />

  <!-- サブタイトル帯 -->
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p class="reveal text-xl md:text-2xl font-bold text-center" style="color: var(--navy);">
        {dx.subtitle}
      </p>
    </div>
  </section>

  <!-- 機能 -->
  <section class="pb-20 md:pb-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          dx.features.map((f, i) => (
            <div class="reveal rounded-2xl border shadow-md p-6 sm:p-8" style={`border-color: var(--border); background-color: var(--bg-elevated); transition-delay: ${(i % 3) * 80}ms;`}>
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-5" style="background-color: var(--accent-soft);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
              </div>
              <h3 class="text-lg font-bold mb-2" style="color: var(--navy);">{f.title}</h3>
              <p class="text-sm md:text-base" style="color: var(--text-muted);">{f.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- メリット -->
  <section class="py-20 md:py-28" style="background-color: var(--bg-subtle);">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="grid gap-12 lg:gap-16 lg:grid-cols-2 items-center">
        <div class="reveal">
          <p class="text-xs md:text-sm tracking-[0.3em] mb-4 font-semibold eyebrow" style="color: var(--accent);">BENEFITS</p>
          <h2 class="heading" style="font-size: clamp(1.6rem, 4vw, 2.5rem);">DXがもたらす3つのメリット</h2>
          <ul class="mt-8 flex flex-col gap-4">
            {
              dx.benefits.map((b) => (
                <li class="flex items-start gap-3 text-base md:text-lg font-medium" style="color: var(--navy);">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full shrink-0 mt-0.5" style="background-color: var(--accent);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
                  </span>
                  {b}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="reveal" style="transition-delay: 120ms;">
          <img src="/images/photos/service-03.jpg" alt="オンラインで相談する様子" width="800" height="600" loading="lazy" decoding="async" class="w-full h-auto rounded-3xl shadow-md" />
        </div>
      </div>
    </div>
  </section>

  <!-- 開発パートナー ZeeSpires ※要確認：内容が確定するまで公開しないこと -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="reveal max-w-3xl">
        {/* 国旗は eyebrow の外に出す。.eyebrow::after の下線が要素幅いっぱいに引かれるため、
            中に入れると国旗の下まで線が伸びてしまう */}
        <div class="mb-4 flex items-center gap-1 text-xs md:text-sm">
          <p class="tracking-[0.3em] font-semibold eyebrow" style="color: var(--accent);">{partnership.eyebrow}</p>
          <span
            class="mt-[3px] inline-block shrink-0 overflow-hidden rounded-[2px] border"
            style="border-color: var(--border);"
          >
            <Icon name="flag:sg-4x3" class="block h-[1.1em] w-auto" title="シンガポール国旗" />
          </span>
        </div>
        <h2 class="heading" style="font-size: clamp(1.6rem, 4vw, 2.5rem);">{partnership.title}</h2>
        <p class="mt-6 text-sm md:text-base leading-relaxed" style="color: var(--text-muted);">{partnership.lead}</p>
        <div
          class="mt-8 flex flex-col gap-5 rounded-2xl border p-6 sm:flex-row sm:items-center sm:gap-7"
          style="border-color: var(--border); background-color: var(--bg-elevated);"
        >
          <img
            src={partnership.partner.logo}
            alt={`${partnership.partner.name} ロゴ`}
            width="1747"
            height="383"
            loading="lazy"
            decoding="async"
            class="h-12 w-auto shrink-0 self-start object-contain sm:self-center"
          />
          <div>
            <p class="text-sm md:text-base leading-relaxed" style="color: var(--text-muted);">
              {partnership.partner.description}
            </p>
            {partnership.partner.url && (
              <a
                href={partnership.partner.url}
                target="_blank"
                rel="noopener"
                class="mt-3 inline-block font-semibold underline decoration-1 underline-offset-4 transition-opacity hover:opacity-70 break-all"
                style="color: var(--accent);"
              >
                {partnership.partner.url}
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          partnership.photos.map((p, i) => (
            <figure
              class="reveal rounded-2xl overflow-hidden border shadow-md"
              style={`border-color: var(--border); background-color: var(--bg-elevated); transition-delay: ${(i % 3) * 80}ms;`}
            >
              <img src={p.src} alt={p.alt} width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
              <figcaption class="px-5 py-4">
                <span class="block text-sm font-bold" style="color: var(--navy);">{p.name}</span>
                <span class="block mt-1 text-xs leading-relaxed" style="color: var(--text-muted);">{p.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <h3 class="reveal mt-20 text-xl md:text-2xl font-bold" style="color: var(--navy);">共同開発の事例</h3>
      <div class="mt-8 grid gap-6 md:gap-8 sm:grid-cols-2">
        {
          partnership.cases.map((c, i) => (
            <div
              class="reveal rounded-2xl border shadow-md overflow-hidden"
              style={`border-color: var(--border); background-color: var(--bg-elevated); transition-delay: ${(i % 2) * 80}ms;`}
            >
              <img
                src={c.image}
                alt={c.title}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                class="w-full aspect-[16/9] object-cover"
              />
              <div class="p-6 sm:p-8">
              <p class="text-sm font-bold tracking-widest mb-3" style="color: var(--accent);">{c.no}</p>
              <h4 class="text-lg font-bold mb-2" style="color: var(--navy);">{c.title}</h4>
              <p class="text-sm md:text-base" style="color: var(--text-muted);">{c.description}</p>
              {c.tags.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {c.tags.map((t) => (
                    <li class="text-xs font-semibold px-3 py-1 rounded-full" style="background-color: var(--accent-soft); color: var(--accent);">
                      {t}
                    </li>
                  ))}
                </ul>
              )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
